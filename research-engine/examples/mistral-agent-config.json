{
  "name": "mistral-demo",
  "workspace": "demo-workspace",
  "command": "python objective.py --params params.json",
  "metric_regex": "metric\\s*[:=]\\s*([0-9.]+)",
  "iterations": 6,
  "seconds_per_trial": 30,
  "maximize": false,
  "patience": 3,
  "baseline_first": true,
  "report": true,
  "agent_provider": "mistral",
  "agent_model": "codestral-latest",
  "agent_temperature": 0.2,
  "agent_max_tokens": 4096,
  "agent_files": [
    "objective.py",
    "params.json"
  ]
}

