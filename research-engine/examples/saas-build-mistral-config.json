{
  "name": "saas-build-mistral",
  "workspace": "saas-build",
  "command": "python check.py",
  "metric_regex": "AUTORESEARCH_SCORE:\\s*([0-9.]+)",
  "objective_file": "spec.md",
  "iterations": 20,
  "seconds_per_trial": 90,
  "maximize": true,
  "patience": 8,
  "baseline_first": true,
  "report": true,
  "ignore_patterns": ["__pycache__", ".git", "runs", ".venv"],
  "agent_provider": "mistral",
  "agent_model": "mistral-large-latest",
  "agent_temperature": 0.2,
  "agent_max_tokens": 8192,
  "agent_files": ["app.py"]
}
